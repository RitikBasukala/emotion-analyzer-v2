# Copy this file to `.env` (same directory) and adjust values as needed.
# Docker Compose (../docker-compose.yml) reads the root-level `.env` for the
# Postgres container; the FastAPI app reads this backend-level `.env` (and
# falls back to the root `.env` too) - keep the POSTGRES_* values identical
# in both if you keep them as two separate files.

# ===== PostgreSQL Database (Supabase is fully deprecated / removed) =====
POSTGRES_USER=emotion_ai
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=emotion_recognition
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== FastAPI Application =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== ML Model Configuration =====
DEVICE=cpu
PRELOAD_MODELS=false

# Text Emotion Model - local safetensors checkpoint (GoEmotions fine-tuned BERT)
TEXT_MODEL_DIR=app/ml/text_emotion/text_model
TEXT_MODEL_MAX_LENGTH=512

# Audio Emotion Model - Whisper transcription + Wav2Vec2 acoustic tone
AUDIO_WHISPER_MODEL=openai/whisper-base
AUDIO_EMOTION_MODEL=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim
AUDIO_EMOTION_LOCAL_MODEL_DIR=app/ml/audio_emotion/audio_model
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_LENGTH_SECONDS=30

# Facial / Video Emotion Model
FACIAL_DETECTOR_BACKEND=opencv
FACIAL_FRAME_EXTRACTION_FPS=2
FACIAL_MAX_FRAMES=30

# ===== Multi-Tier Fusion Engine (weights must sum to 1.0) =====
FUSION_TEXT_WEIGHT=0.30
FUSION_AUDIO_WEIGHT=0.30
FUSION_FACIAL_WEIGHT=0.40
# "weighted_average" = late fusion only; "cross_attention" = blends gated
# cross-modal fusion with late-fusion soft-voting for the final decision;
# the gated projection uses softmax-normalized modality features, and
# "multi_tier" is kept as a compatibility alias.
FUSION_METHOD=cross_attention
FUSION_MID_LATE_BLEND=0.5

# ===== Storage =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
