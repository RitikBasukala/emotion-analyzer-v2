# Copy to `.env` in this same directory (project root) before running
# `docker-compose up`. These values are consumed by docker-compose.yml to
# provision the Postgres container. Keep POSTGRES_USER/PASSWORD/DB in sync
# with backend/.env so the FastAPI app can connect to the same database.

# ===== PostgreSQL (Docker container) =====
POSTGRES_USER=emotion_ai
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=emotion_recognition
POSTGRES_PORT=5432

# ===== Adminer (optional lightweight DB UI, http://localhost:8080) =====
ADMINER_PORT=8080
